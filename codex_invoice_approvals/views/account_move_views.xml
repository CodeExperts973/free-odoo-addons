<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit.invoice.approvals</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][2]" position="replace">
                <button name="action_request_approval" string="Request Approval" type="object" class="btn-primary"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"/>
                <button name="action_approve" string="Approve" type="object" class="btn-primary"
                        invisible="state not in ('waiting_payment_validator_1', 'waiting_payment_validator_2', 'waiting_support_approval', 'waiting_accounting_approval', 'waiting_general_approval') or move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"
                        groups="codex_invoice_approvals.group_invoice_payment_validator_1,codex_invoice_approvals.group_invoice_payment_validator_2,codex_invoice_approvals.group_invoice_support_approver,codex_invoice_approvals.group_invoice_accounting_approver,codex_invoice_approvals.group_invoice_general_approver"/>
                <button name="action_reject" string="Reject" type="object" class="oe_link"
                        invisible="state not in ('waiting_payment_validator_1', 'waiting_payment_validator_2', 'waiting_support_approval', 'waiting_accounting_approval', 'waiting_general_approval') or move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"
                        groups="codex_invoice_approvals.group_invoice_payment_validator_1,codex_invoice_approvals.group_invoice_payment_validator_2,codex_invoice_approvals.group_invoice_support_approver,codex_invoice_approvals.group_invoice_accounting_approver,codex_invoice_approvals.group_invoice_general_approver"/>
            </xpath>
        </field>
    </record>
</odoo>