<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.view.inherit.sales.approvals</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][2]" position="replace">
                <button name="action_request_manager_approval" string="Request Approval" type="object" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_manager_approve" string="Manager Approve" type="object" class="btn-primary" invisible="state != 'sales_manager_approve'" groups="sales_team.group_sale_manager"/>
                <button name="action_costing_approve" string="Costing Approve" type="object" class="btn-primary" invisible="state != 'costing_approve'" groups="codex_sales_approvals.group_sale_cost_validator"/>
                <button name="action_reject" string="Reject" type="object" class="oe_link" invisible="state not in ('sales_manager_approve', 'costing_approve')" groups="sales_team.group_sale_manager,codex_sales_approvals.group_sale_cost_validator"/>
            </xpath>
        </field>
    </record>
</odoo>